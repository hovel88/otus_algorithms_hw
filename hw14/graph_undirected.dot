graph G {
  // Неориентированный двудольный граф A(3,4) с 5 рёбрами
  rankdir=LR;
  node [shape=circle, style=filled];

  // Левая доля A = {0,1,2}
  0 [fillcolor=lightblue, label="0"];
  1 [fillcolor=lightblue, label="1"];
  2 [fillcolor=lightblue, label="2"];

  // Правая доля B = {3,4,5,6}
  3 [fillcolor=pink, label="3"];
  4 [fillcolor=pink, label="4"];
  5 [fillcolor=pink, label="5"];
  6 [fillcolor=pink, label="6"];

  subgraph cluster_left {
    label = "Доля A (3 вершины)";
    color = blue;
    style = dashed;
    0;
    1;
    2;
  }

  subgraph cluster_right {
    label = "Доля B (4 вершины)";
    color = red;
    style = dashed;
    3;
    4;
    5;
    6;
  }

  // Рёбра (только между долями)
  0 -- 3 [label="e0"];
  1 -- 3 [label="e1"];
  1 -- 4 [label="e2"];
  1 -- 5 [label="e3"];
  2 -- 6 [label="e4"];
}
